<Layouts.auth heading={@heading} subtitle={@subtitle} flash={@flash}>
  <.auth_container class="flex gap-3 justify-center">
    <.button_link
      :if={Plausible.Auth.check_registration_enabled() == :ok}
      href={Routes.auth_path(@conn, :register_form)}
      mt?={false}
    >
      Start free trial
    </.button_link>
    <.button_link href={Routes.auth_path(@conn, :login_form)} theme="secondary" mt?={false}>
      Sign in
    </.button_link>
  </.auth_container>
</Layouts.auth>
